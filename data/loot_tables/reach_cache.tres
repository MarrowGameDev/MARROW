[resource]
script = ExtResource("1_loottable")
table_id = "reach_cache"
display_name = "Reach Cache"
description = "Reach Ridge. Arms only. The guaranteed Arm Bone is what makes the region's trial gate passable, so the chest can teach reach without depending on a roll."
